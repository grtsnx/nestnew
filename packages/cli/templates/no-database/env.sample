# Server
PORT=3000
NODE_ENV=development

# Public URLs (required when NODE_ENV=production)
PRODUCTION_URL=http://localhost:3000
DEVELOPMENT_URL=http://localhost:3000
PLATFORM_URL=http://localhost:3000

# Application (PLATFORM_NAME required in production)
PLATFORM_NAME=your-platform
ENABLE_API_DOCS=true
LOG_LEVEL=info

# Rate limiting (requests per IP per window)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=30

# Comma-separated extra CORS origins (optional)
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Redis (required in production; optional in development)
# REDIS_URL=redis://localhost:6379

# Process role: all (default, API + in-process email worker) | api | worker
# Use api + start:worker when you want a separate consumer process.
# PROCESS_ROLE=all

# Email
# EMAIL_PROVIDER: test | google | smtp | resend (must not be test in production)
EMAIL_PROVIDER=test
PLATFORM_SUPPORT=noreply@example.com
PLATFORM_LOGO_URL=
COLOR_CODE=#635BFF

# Google email (when EMAIL_PROVIDER=google)
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=

# SMTP (set EMAIL_PROVIDER=smtp)
# Port is 587 STARTTLS. From address is PLATFORM_SUPPORT.
# SMTP_HOST=smtp.example.com
# SMTP_USER=apikey
# SMTP_PASS=secret

# Resend (when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=


# Files (opt-in FilesModule; FILES_PROVIDER=fs | s3 | r2)
# Production must be s3 or r2. The generator adds AWS peers when s3 is selected.
FILES_PROVIDER=fs
FILES_FS_ROOT=.uploads
# FILES_S3_BUCKET=
# FILES_S3_REGION=
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_ENDPOINT=
# FILES_R2_ACCOUNT_ID=
# FILES_R2_BUCKET=
# FILES_R2_ACCESS_KEY_ID=
# FILES_R2_SECRET_ACCESS_KEY=

# Optional Axiom drain (evlog). Both must be set to enable ingest.
# AXIOM_API_KEY=
# AXIOM_DATASET=
