# Platform admin seed (run: bun prisma db seed; skipped when ADMIN_EMAIL or ADMIN_PASSWORD is unset)
ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_PASSWORD=
# Axiom logging (pair API key with dataset)
AXIOM_API_KEY=
AXIOM_DATASET=
# Autumn billing secret
# AUTUMN_SECRET_KEY=
# Better Auth Infra — dash + sentinel (API key and KV URL from Better Auth Infrastructure dashboard)
BETTER_AUTH_API_KEY=
# Frontend page for OAuth/API errors (defaults to {PLATFORM_URL}/auth/error)
BETTER_AUTH_ERROR_URL=http://localhost:3000/auth/error
BETTER_AUTH_KV_URL=
# Session/crypto secret (min 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional extra trusted origins, comma-separated
# BETTER_AUTH_TRUSTED_ORIGINS=
# Public API base URL — use your PUBLIC deploy URL (not localhost) when Better Auth Infra is enabled
BETTER_AUTH_URL=http://localhost:3000
# Brand accent color (required in production)
COLOR_CODE=#635BFF
# Extra CORS origins, comma-separated (optional)
CORS_ORIGINS=
# Postgres URL for Prisma (required in production)
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# Optional Postgres pool size (default 10)
# DB_POOL_MAX=10
# Dev app URL / CORS origin (required in production)
DEVELOPMENT_URL=http://localhost:3000
# DiceBear style for Gravatar fallback — https://www.dicebear.com/styles/
# DICEBEAR_STYLE=loops
# Google mailbox (when EMAIL_PROVIDER=google)
# EMAIL_ADDRESS=
# Optional From address for outbound mail (defaults to PLATFORM_SUPPORT)
# EMAIL_FROM=hello@example.com
# Google mailbox app password (when EMAIL_PROVIDER=google)
# EMAIL_PASSWORD=
# Email provider: test | google | smtp | resend (required in production; must not be test)
EMAIL_PROVIDER=test
# Optional Reply-To (defaults to PLATFORM_SUPPORT when unset)
# EMAIL_REPLY_TO=support@example.com
# Enable Swagger/Scalar docs (defaults false in production)
ENABLE_API_DOCS=true
# Local filesystem root when FILES_PROVIDER=fs
FILES_FS_ROOT=.uploads
# Files backend: fs | s3 | r2 (required in production; must be s3 or r2)
FILES_PROVIDER=fs
# Cloudflare R2 (when FILES_PROVIDER=r2)
# FILES_R2_ACCOUNT_ID=
# FILES_R2_BUCKET=
# FILES_R2_ACCESS_KEY_ID=
# FILES_R2_SECRET_ACCESS_KEY=
# S3 (when FILES_PROVIDER=s3)
# FILES_S3_BUCKET=
# FILES_S3_REGION=
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_ENDPOINT=
# GitHub OAuth — callback: {BETTER_AUTH_URL}/v1/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth — callback: {BETTER_AUTH_URL}/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Multi-session plugin (default true unless false/0)
MULTI_SESSION_ENABLED=true
# Runtime environment: development | production | test
NODE_ENV=development
# Optional platform logo URL for emails
PLATFORM_LOGO_URL=
# Product/platform name (required in production)
PLATFORM_NAME=your-platform
# Contact / reply address shown in emails (always required)
PLATFORM_SUPPORT=support@example.com
# Frontend/platform URL / CORS origin (required in production)
PLATFORM_URL=http://localhost:3000
# HTTP listen port
PORT=3000
# Process role: all | api | worker (default all)
# PROCESS_ROLE=all
# Production API URL / CORS origin (required in production)
PRODUCTION_URL=http://localhost:3000
# Rate limit max requests per window
RATE_LIMIT_MAX=30
# Rate limit window in milliseconds
RATE_LIMIT_TTL=60000
# Redis URL for queues/cache (required in production)
# REDIS_URL=redis://localhost:6379
# Resend API key (when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=
# Sentinel free-trial abuse (device id required on signup). Default: on in production, off otherwise.
# SENTINEL_FREE_TRIAL_ABUSE=false
# SMTP host (when EMAIL_PROVIDER=smtp; port 587 STARTTLS)
# SMTP_HOST=smtp.example.com
# SMTP username (when EMAIL_PROVIDER=smtp)
# SMTP_USER=apikey
# SMTP password (when EMAIL_PROVIDER=smtp)
# SMTP_PASS=secret
# IANA timezone for emails and calendar dates (default Africa/Lagos)
TIMEZONE=Africa/Lagos
