{
  "name": "builderbackend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:migrate:dev": "bunx --bun prisma migrate dev",
    "prisma:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:seed": "bun prisma db seed",
    "build": "bun run prisma:generate && rm -rf dist && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"src/**/*.hbs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"src/**/*.hbs\"",
    "start": "nest start",
    "start:dev": "bash scripts/ensure-dev-port.sh && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:api": "PROCESS_ROLE=api node dist/main",
    "start:worker": "node dist/worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run build && bun run test:cov && bun run test:e2e",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:app": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=test/app/",
    "test:lib": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=test/lib/",
    "test:middleware": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=test/middleware/",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.0",
    "@better-auth/infra": "^0.3.7",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.1.0",
    "@opencoredev/email-sdk": "^3.0.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/nestjs-api-reference": "^1.2.8",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "autumn-js": "^1.2.53",
    "better-auth": "^1.7.0",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "evlog": "^2.26.0",
    "files-sdk": "^3.1.1",
    "gravatar": "^1.8.2",
    "handlebars": "^4.7.9",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "moment-timezone": "^0.6.3",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/gravatar": "^1.8.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/(app|middleware|lib)/.*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)\\.js$": "<rootDir>/src/$1",
      "^src/(.*)$": "<rootDir>/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^files-sdk$": "<rootDir>/test/mocks/files-sdk.ts",
      "^files-sdk/fs$": "<rootDir>/test/mocks/files-sdk-fs.ts",
      "^files-sdk/s3$": "<rootDir>/test/mocks/files-sdk-s3.ts",
      "^files-sdk/r2$": "<rootDir>/test/mocks/files-sdk-r2.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts",
      "!src/worker.ts",
      "!src/**/*.module.ts",
      "!src/middleware/config/setup-api-docs.ts",
      "!src/lib/prisma/generated/**"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24.9.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
